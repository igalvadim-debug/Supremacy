{
  "name": "iptv-player",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "IPTV-плеер для Android TV на базе Capacitor (Vite + TypeScript)",
  "scripts": {
    "dev": "vite",
    "vendor": "node scripts/copy-vendor.mjs",
    "prebuild": "npm run vendor",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sync": "npm run build && cap sync android",
    "open": "cap open android",
    "apk": "npm run sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "hls.js": "1.5.20",
    "typescript": "~5.6.3",
    "vite": "^6.0.0"
  }
}
